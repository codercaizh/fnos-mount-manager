#!/usr/bin/env bash
set -euo pipefail
APPDEST="${TRIM_APPDEST:?missing TRIM_APPDEST}"
PKGVAR="${TRIM_PKGVAR:?missing TRIM_PKGVAR}"
BIN="$(readlink -f "$APPDEST/server/mountmgr")"
PIDFILE="$PKGVAR/service.pid"
SOCKET="$APPDEST/app.sock"
STATE="$PKGVAR/private/mounts.json"
running() {
  [[ -f "$PIDFILE" ]] || return 1
  local pid cmd
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  cmd="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  # During in-place upgrades Linux may append " (deleted)" to the old
  # executable pathname. It is still our daemon and must be stopped safely.
  cmd="${cmd% (deleted)}"
  [[ "$cmd" == "$BIN" ]]
}
case "${1:-}" in
 start)
  [[ "$(id -u)" -eq 0 ]] || { echo 'NAS 工具箱需要 root/CAP_SYS_ADMIN 权限' >&2; exit 1; }
  mkdir -p "$PKGVAR/private"
  chmod 700 "$PKGVAR/private"
  if running; then echo "NAS 工具箱已运行";exit 0;fi
  rm -f "$PIDFILE" "$SOCKET"
  "$BIN" --socket "$SOCKET" --state "$STATE" >> "$PKGVAR/service.log" 2>&1 &
  echo "$!" > "$PIDFILE"
  chmod 600 "$PIDFILE" "$PKGVAR/service.log"
  for i in $(seq 1 50);do
    if running && [[ -S "$SOCKET" ]];then echo "NAS 工具箱已启动";exit 0;fi
    sleep 0.2
  done
  echo "服务启动失败，日志: $PKGVAR/service.log" >&2
  exit 1
  ;;
 stop)
  if running;then
    pid="$(cat "$PIDFILE")"
    kill -TERM "$pid"
    # Allow the Go service to cancel rclone, wait for its exit, and persist
    # paused task checkpoints. Never force-kill a transfer during upgrade.
    for i in $(seq 1 150);do
      if ! running;then break;fi
      sleep 0.2
    done
    if running;then
      echo "安全停止超时（PID=$pid），复制任务可能尚未保存；已取消本次停止，请稍后重试升级" >&2
      exit 1
    fi
  fi
  rm -f "$PIDFILE" "$SOCKET"
  ;;
 status)
  if running && [[ -S "$SOCKET" ]];then echo "NAS 工具箱运行中";exit 0;fi
  echo "NAS 工具箱未运行";exit 1
  ;;
 *) echo "Usage: $0 start|stop|status" >&2;exit 2;;
esac
